         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "POST /ratings (missing API key)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Aventus\",\n  \"brand\": \"Creed\",\n  \"description\": \"Smoky pineapple opening settling into a musky vanilla dry-down.\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{baseUrl}}/ratings",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "ratings"
       ]
      },
      "description": "No X-API-Key header sent. Confirms the auth dependency rejects unauthenticated writes with 401 rather than silently succeeding."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status 401', function () { pm.response.to.have.status(401); });",
         "pm.test('RFC 7807 problem body', function () {",
         "  var body = pm.response.json();",
         "  pm.expect(body).to.have.property('detail');",
         "  pm.expect(body.detail).to.have.property('type');",
         "  pm.expect(body.detail).to.have.property('title', 'Unauthorized');",
         "  pm.expect(body.detail).to.have.property('status', 401);",
         "});"
        ]
       }
      }
     ]
    }
   ]
  }
 ]
