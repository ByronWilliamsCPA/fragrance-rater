# ============================================================================
# Supply Chain Security Configuration
# ============================================================================
# This project uses secure package indexes for supply chain security:
#   1. Google Assured OSS (SLSA Level 3) - third-party packages
#   2. Internal Artifact Registry - organization packages
#   3. PyPI (fallback) - packages not in Assured OSS
#
# Documentation: https://cloud.google.com/assured-open-source-software

# ============================================================================
# Infisical - Centralized Secrets Management
# ============================================================================
# Secrets are managed via Infisical instead of GitHub Secrets.
# Domain: https://infisical.williamshome.family
#
# For local development, use Infisical CLI:
#   infisical run --env=dev -- uv run python main.py
#
# Or export secrets to .env:
#   infisical export --env=dev > .env.local
#
# Machine Identity (for CI/CD) - Add these to GitHub Secrets:
# INFISICAL_CLIENT_ID=your-machine-identity-client-id
# INFISICAL_CLIENT_SECRET=your-machine-identity-client-secret

# ============================================================================
# Google Cloud - Assured OSS
# ============================================================================
# Backs scripts/validate_assuredoss.py (invoked via `nox -s validate_assuredoss`),
# which validates ADC credentials against the Assured OSS index configured in
# pyproject.toml's [[tool.uv.index]] entries. Disabled by default
# (USE_ASSURED_OSS defaults to false in that script); only needed if you
# enable pulling packages through the assured-oss index.

# Google Cloud Project ID
# Find this in your GCP Console: https://console.cloud.google.com
GOOGLE_CLOUD_PROJECT=assured-oss-457903

# Google Service Account Credentials (Base64 encoded)
# Setup Instructions:
# 1. Create a service account with "Artifact Registry Reader" role
# 2. Download the JSON key file
# 3. Base64 encode it: base64 -w 0 service-account-key.json
# 4. Store in Infisical as GOOGLE_APPLICATION_CREDENTIALS_B64 (the exact name
#    scripts/validate_assuredoss.py reads)
#
# For local development, use Application Default Credentials:
#   gcloud auth application-default login
#
# Or set the file path directly:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================================================
# AI/ML Service API Keys
# ============================================================================

# OpenRouter API Key (for LLM access)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter Configuration (optional)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.7

# Fragella API Key (optional; enables `import-data fragella-lookup`/
# `fragella-usage`). A rate-limited (20 requests/month free tier),
# operator-invoked reference lookup for resolving fragrance identity
# ambiguity - never a primary or auto-imported catalog source. See
# docs/planning/adr/adr-002-data-source-strategy.md's 2026 amendment.
# Get your key from: https://api.fragella.com/dashboard.html
#
# The client (src/fragrance_rater/services/fragella_client.py) is built from
# Fragella's published docs (https://api.fragella.com/docs.html), not yet
# verified against a live authenticated response - see the #ASSUME/#VERIFY
# marker in that file's module docstring before relying on it for a real
# gap-filling decision.
FRAGELLA_API_KEY=your-fragella-api-key-here

# ============================================================================
# Project Configuration
# ============================================================================
PROJECT_NAME=Fragrance Rater

# Shared household API key required on mutating endpoints (POST /ratings),
# sent by callers as the X-API-Key header. Required in any environment that
# serves traffic: when unset, mutating endpoints fail closed with 503 rather
# than allowing unauthenticated writes. Left unset (commented out) here on
# purpose: any non-empty value, including a placeholder, is accepted as the
# real key by fragrance_rater.middleware.auth, so a copied-verbatim example
# value would silently become a known, working credential. Generate a value,
# do not reuse an example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# FRAGRANCE_RATER_API_KEY=

# Logging Configuration
# Case-insensitive; accepts DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Application Settings
# NOTE: debug mode is read from FRAGRANCE_DEBUG (not the bare DEBUG name)
# to avoid colliding with ambient DEBUG values set by unrelated tooling
# (e.g. DEBUG=express:*).
FRAGRANCE_DEBUG=False

# Database Configuration
# This app uses an async SQLAlchemy engine; the URL must use the
# postgresql+asyncpg:// scheme (a bare postgresql:// or sqlite:// URL will
# not work with the async engine).
DATABASE_URL=postgresql+asyncpg://fragrance_rater:password@localhost:5432/fragrance_rater
# DATABASE_ECHO=False

# ============================================================================
# CI/CD and Code Quality Services
# ============================================================================

# Codecov Token (for test coverage reporting)
# Get your token from: https://app.codecov.io/gh/ByronWilliamsCPA/fragrance_rater/settings
# Required for uploading coverage reports to Codecov in CI/CD
# IMPORTANT: Add this to GitHub Secrets as CODECOV_TOKEN
CODECOV_TOKEN=your-codecov-token-here

# SonarCloud Token (for continuous code quality analysis)
# Get your token from: https://sonarcloud.io/account/security
# Required for SonarCloud analysis in CI/CD
# IMPORTANT: Add this to GitHub Secrets as SONAR_TOKEN
SONAR_TOKEN=your-sonarcloud-token-here

# SonarCloud Configuration
SONAR_ORGANIZATION=williaby
SONAR_PROJECT_KEY=ByronWilliamsCPA_fragrance_rater

# ============================================================================
# Redis Configuration (Caching)
# ============================================================================

# Redis Connection URL
# Format: redis://[:password]@host:port/db
# For TLS: rediss://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Docker Configuration
# ============================================================================

# Application port (backend API)
APP_PORT=8000

# Database port (if using PostgreSQL)
DB_PORT=5432
# Required. Compose fails fast if this is unset, so there is no weak
# built-in default to inherit. Left commented out here on purpose: Compose's
# ${DB_PASSWORD:?...} guard only checks for presence, not for a placeholder
# value, so a copied-verbatim example password would satisfy the guard and
# become the real, publicly-known database password. Generate a value,
# do not reuse an example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DB_PASSWORD=

# Environment
ENVIRONMENT=development
VERSION=latest


# Frontend port (Vite dev server in development, nginx in production)
FRONTEND_PORT=3000

# API URL for frontend (used during frontend build for production)
VITE_API_URL=http://localhost:8000

# Frontend replicas in production
FRONTEND_REPLICAS=1

# Required by docker-compose.prod.yml. Production traffic enters through
# Traefik and its Authentik forward-auth middleware; app, frontend, and
# PostgreSQL publish no host ports in the production Compose render.
# Dedicated external Docker network containing only Traefik and this frontend.
# FRAGRANCE_TRAEFIK_NETWORK=fragrance-rater-edge
# FRAGRANCE_HOST=fragrance.example.com
# AUTHENTIK_MIDDLEWARE=authentik@file

# JSON array of Authentik usernames permitted to administer calibration.
# Keep this aligned with the verified identity header emitted by Authentik.
# CALIBRATION_ADMIN_USERNAMES=["manager"]
